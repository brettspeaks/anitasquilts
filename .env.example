# ==============================================================================
# Supabase Configuration
# ==============================================================================
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ==============================================================================
# Cloudflare R2 / AWS S3 Storage Configuration
# ==============================================================================
# For Cloudflare R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# For AWS S3: leave empty or specify https://s3.<REGION>.amazonaws.com
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=your-s3-access-key-id
S3_SECRET_ACCESS_KEY=your-s3-secret-access-key
S3_BUCKET_NAME=concert-videos
# Public CDN URL or R2.dev bucket domain to serve videos directly
S3_PUBLIC_DOMAIN=https://pub-your-bucket.r2.dev

# ==============================================================================
# Google Gemini AI Configuration
# ==============================================================================
# Google AI Studio API key for Gemini 1.5 Flash
GEMINI_API_KEY=AIzaSy...

# ==============================================================================
# Worker / Webhook Security
# ==============================================================================
# Shared secret for authenticating serverless worker webhooks
WEBHOOK_SECRET=your-random-secure-webhook-secret
